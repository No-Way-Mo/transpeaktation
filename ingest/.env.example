# Optional. Without it DataSF throttles by IP; with it you get a much higher limit.
# Get one free at https://data.sf.gov/profile/edit/developer_settings
DATASF_APP_TOKEN=

# Live speed polling (python -m pull.poll). Free tier: 100k Directions requests/month.
# https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=

# 511.org traffic events + Muni vehicles; those sources are skipped without it.
# Free: https://511.org/open-data/token (~60 requests/hour per token)
SF511_API_KEY=

# TomTom Traffic API (flow tiles, 200k/month free; flow segment data, 20k/month). https://developer.tomtom.com
TOMTOM_API_KEY=

# Databases: see README "Set up secrets". Passwords come from a teammate, never commit them.
MONGODB_URI="mongodb+srv://transpeaktation-app:<password>@transpeaktation.avklhhn.mongodb.net/transpeaktation?retryWrites=true&w=majority"
TIGER_DATABASE_URL="postgresql://tsdbadmin:<password>@dp0coukufh.olbg9ahjvp.tsdb.cloud.timescale.com:39233/tsdb?sslmode=require"

# Optional worker geocoding for incidents with no location. Off unless set: GEOCODER=mapbox
# (uses MAPBOX_TOKEN, permanent geocoding since results are stored). Leave empty to skip.
GEOCODER=

# Protects POST /ingest/refresh (python -m worker serve). Mutating + expensive: 16+ random chars, never in web/ or
# any NEXT_PUBLIC_* var. Empty = the endpoint is disabled. Generate: python -c "import secrets;print(secrets.token_urlsafe(24))"
INGEST_TOKEN=
