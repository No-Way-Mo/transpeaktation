# Optional. Without it DataSF throttles by IP; with it you get a much higher limit.
# Get one free at https://data.sf.gov/profile/edit/developer_settings
DATASF_APP_TOKEN=

# MongoDB Atlas (Designathon / Transpeaktation, cluster "transpeaktation"). Ask the team for the password.
MONGODB_URI=mongodb+srv://transpeaktation-app:<password>@transpeaktation.avklhhn.mongodb.net/transpeaktation?retryWrites=true&w=majority

# Live speed polling (python -m pull.poll). Free tier: 100k Directions requests/month.
# https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=

# 511.org traffic events + Muni vehicles. Free: https://511.org/open-data/token
SF511_API_KEY=

# Tiger Data service `transPEAKtation` (db tsdb) as a postgres:// connection string. Ask the team.
# Used by the ingestion worker (python -m worker) to append traffic_metrics.
TIGER_DATABASE_URL=

# Optional worker geocoding for records with no location. Off unless set: GEOCODER=mapbox
# (uses MAPBOX_TOKEN, permanent geocoding since results are stored). Leave empty to skip.
GEOCODER=
