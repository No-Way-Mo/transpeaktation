[Unit]
Description=transPEAKtation poll
After=network-online.target
Wants=network-online.target

[Service]
User=tp
WorkingDirectory=/opt/transpeaktation/ingest
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/transpeaktation/ingest/.venv/bin/python -m pull.poll
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
