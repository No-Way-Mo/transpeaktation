# Voice -> intent. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Confirm -> transaction. Devnet until we demo; users sign in their wallet, no server keypair here.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Places + routes with live traffic (Mapbox Search Box + Directions driving-traffic). https://account.mapbox.com/access-tokens/
# Optional: without it, or when Mapbox fails / hits quota, the API falls back to OSRM + Nominatim (no traffic).
# Locally, a MAPBOX_TOKEN in ingest/.env is used when this one is empty.
# Same account as ingest's pull.poll, which already uses ~73k of the 100k free Directions requests/month.
MAPBOX_TOKEN=

# Browser origins allowed to call the API (comma-separated). Add the deployed web URL here.
ALLOWED_ORIGINS=http://localhost:3000

# Databases: see README "Set up secrets". Passwords come from a teammate, never commit them.
MONGODB_URI="mongodb+srv://transpeaktation-app:<password>@transpeaktation.avklhhn.mongodb.net/transpeaktation?retryWrites=true&w=majority"
TIGER_DATABASE_URL="postgresql://tsdbadmin:<password>@dp0coukufh.olbg9ahjvp.tsdb.cloud.timescale.com:39233/tsdb?sslmode=require"

# ml/'s route decision service (contracts/route_decision.md). Empty = api/'s own heuristic picks the route.
ML_URL=

# Gemini words the transPEAKtation card's explanation from the plan's facts (app/advice.py). Empty = template text.
# https://aistudio.google.com/apikey · GEMINI_MODEL defaults to gemini-flash-latest.
GEMINI_API_KEY=
GEMINI_MODEL=
